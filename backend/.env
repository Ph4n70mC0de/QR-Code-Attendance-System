# QR Code Attendance System - Environment Configuration
# IMPORTANT: In production, use strong unique values for all secrets!

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME="QR Code Attendance System"
APP_DEBUG=False
APP_ENV=development  # Options: development, staging, production

# ============================================
# SECURITY SETTINGS
# ============================================
# Generate a secure key for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Login security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# ============================================
# PASSWORD POLICY
# ============================================
MIN_PASSWORD_LENGTH=8
REQUIRE_PASSWORD_SPECIAL=True
REQUIRE_PASSWORD_NUMBER=True
REQUIRE_PASSWORD_UPPERCASE=True

# ============================================
# DATABASE SETTINGS
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qr_attendance
DB_USER=root
DB_PASSWORD=

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=False  # Set to True for SQL debugging (development only)

# ============================================
# CORS SETTINGS
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=True

# ============================================
# QR CODE SETTINGS
# ============================================
QR_CODE_EXPIRY_MINUTES=5
QR_CODE_SIZE=256

# ============================================
# FILE UPLOAD SETTINGS
# ============================================
MAX_UPLOAD_SIZE_MB=10

# ============================================
# LOGGING SETTINGS
# ============================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="%(levelname)s: %(message)s"